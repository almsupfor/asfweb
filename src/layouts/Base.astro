---
import '../styles/global.css';
import { site, nav } from '../data/site';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description = site.tagline, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : site.name;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Besökarens val av ljust eller mörkt läge sätts före första målningen så att sidan inte blinkar.
      try {
        const t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dim' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#innehall">Hoppa till innehåll</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={site.name}>
          <span class="brand-full" aria-hidden="true">{site.name}</span>
          <span class="brand-short" aria-hidden="true">{site.short}</span>
        </a>
        <ThemeToggle />
        <a class="button header-cta" href="/bli-medlem">Bli medlem</a>
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="huvudmeny">
          <svg class="menu-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/></svg>
          <span class="menu-label">Meny</span>
        </button>
        <nav id="huvudmeny" aria-label="Huvudmeny">
          {nav.map((i) => <a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>)}
          <a class="button nav-cta" href="/bli-medlem">Bli medlem</a>
        </nav>
      </div>
    </header>
    <main id="innehall" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{site.name}</strong></p>
        <p class="meta">Föreningen är fristående från Almtuna IS.</p>
      </div>
    </footer>
    <a class="to-top-fab" href="#innehall" aria-label="Till toppen">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.getElementById('huvudmeny');
      if (btn && menu) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          menu.classList.toggle('open', open);
          if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            set(false);
            btn.focus();
          }
        });
      }
    </script>
    <script>
      // Knappen går igenom ljust, halvmörkt och mörkt. Utan eget val följer sidan webbläsarens inställning.
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
      const query = matchMedia('(prefers-color-scheme: dark)');
      const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')].map((m) => ({ m, content: m.content, media: m.media }));
      const chrome: Record<string, string> = { light: '#ffffff', dim: '#2b2b31', dark: '#121214' };
      const next: Record<string, string> = { light: 'dim', dim: 'dark', dark: 'light' };
      const current = () => root.dataset.theme || (query.matches ? 'dark' : 'light');
      const sync = () => {
        // Eget val gäller båda webbläsarfärgerna. Utan val behåller de sina media-villkor.
        metas.forEach(({ m, content, media }) => {
          if (!root.dataset.theme) { m.content = content; m.setAttribute('media', media); }
          else { m.content = chrome[root.dataset.theme]; m.removeAttribute('media'); }
        });
      };
      toggles.forEach((t) => t.addEventListener('click', () => {
        const mode = next[current()];
        root.dataset.theme = mode;
        try { localStorage.setItem('tema', mode); } catch {}
        sync();
      }));
      query.addEventListener('change', sync);
      sync();
    </script>
    <script>
      // Pilen till toppen visas först när man scrollat en bit.
      const fab = document.querySelector<HTMLElement>('.to-top-fab');
      if (fab) {
        const update = () => fab.classList.toggle('show', scrollY > 40);
        addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>
    <script>
      // Externa länkar öppnas i ny flik. Gäller alla länkar på sidan, även nya.
      for (const a of document.querySelectorAll<HTMLAnchorElement>('main a[href], footer a[href]')) {
        if (!/^https?:$/.test(a.protocol) || a.origin === location.origin) continue;
        a.target = '_blank';
        a.rel = [...new Set([...a.rel.split(/\s+/), 'noopener', 'noreferrer'])].filter(Boolean).join(' ');
        if (!a.querySelector('.sr-only')) {
          const hint = document.createElement('span');
          hint.className = 'sr-only';
          hint.textContent = ' (öppnas i ny flik)';
          a.append(hint);
        }
      }
    </script>
  </body>
</html>

<style is:global>
  html { scroll-padding-top: 8rem; }
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .bar { display: grid; grid-template-columns: 1fr auto auto; align-items: center; column-gap: .75rem; padding-block: .75rem 0; }
  .brand { font-weight: 800; font-size: 1.0625rem; color: var(--red); text-decoration: none; min-width: 0; }
  .brand-short { display: none; }
  .header-cta { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 2.75rem; padding: 0 1.1rem; white-space: nowrap; border: 1px solid transparent; line-height: 1.2; }
  .menu-toggle { display: none; align-items: center; gap: .5rem; min-height: 2.75rem; padding: 0 1.1rem; font: inherit; line-height: 1.2; font-weight: 600; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: .4rem; cursor: pointer; }
  .menu-toggle:hover { background: var(--bg-soft); }
  .bar nav { grid-column: 1 / -1; display: flex; flex-wrap: wrap; column-gap: 1.5rem; padding-block: .25rem .5rem; }
  .bar nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding-block: .5rem; }
  .bar nav a:hover { color: var(--red); text-decoration: underline; text-underline-offset: .25em; }
  .bar nav a[aria-current] { color: var(--red); }
  .bar nav a.nav-cta { display: none; }
  .bar .theme-toggle { margin-inline-start: 0; }
  a:focus-visible, button:focus-visible, main:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  main:focus-visible { outline: none; }
  .hero a:focus-visible { outline-color: #fff; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip-link { position: absolute; left: .5rem; top: -4rem; z-index: 20; background: var(--bg); color: var(--ink); padding: .65rem 1rem; border-radius: .4rem; border: 2px solid var(--red); font-weight: 600; }
  .skip-link:focus { top: .5rem; }
  /* Smalare än 48rem ryms inte länkarna på en rad: de läggs i en panel bakom menyknappen. */
  @media (max-width: 47.99rem) {
    html { scroll-padding-top: 5rem; }
    .bar { padding-block: .75rem; }
    .js .menu-toggle { display: inline-flex; }
    .js .bar nav { display: none; }
    .header-cta { display: none; }
    .bar nav a.nav-cta, .bar nav a.nav-cta:hover { display: inline-flex; align-items: center; align-self: flex-start; min-height: 2.75rem; margin-top: .5rem; padding: 0 1.2rem; color: #fff; text-decoration: none; font-weight: 600; }
    .bar nav a.nav-cta:hover { background: var(--red-fill-hover); }
    .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .menu-toggle { width: 2.75rem; padding: 0; justify-content: center; }
    .js .bar nav.open { display: flex; flex-direction: column; flex-wrap: nowrap; position: absolute; top: 100%; left: 0; right: 0; padding: .5rem clamp(1rem, 3vw, 2rem) 1rem; background: var(--bg); border-bottom: 1px solid var(--line); max-height: calc(100dvh - 4.5rem); overflow-y: auto; }
  }
  @media (max-width: 21rem) {
    .brand-full { display: none; }
    .brand-short { display: inline; }
  }
  .site-footer { background: var(--bg-soft); border-top: 1px solid var(--line); padding: 2rem 0; }
  @media (max-width: 47.99rem) {
    .site-footer { padding: 1rem 0; }
    .site-footer p { margin: 0; }
    .site-footer p + p { margin-top: .25rem; }
  }
</style>
