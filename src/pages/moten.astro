---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Möten" description="Nästa möte, kallelse och hur föreningens möten fungerar.">
  <PageHead title="Möten">
    <p class="lead">Här hittar du nästa möte och hur föreningens möten fungerar.</p>
  </PageHead>
  <div class="wrap page">
    <div class="prose">
      <h2>Nästa möte</h2>
      <div id="next-meeting" aria-live="polite">
        <p>Hämtar nästa möte …</p>
      </div>

      <h2>Om mötena</h2>
      <ul>
        <li>Ordinarie årsmöte hålls en gång per år.</li>
        <li>Kallelse skickas till medlemmarna senast två veckor före mötet.</li>
        <li>Medlem som har betalat medlemsavgiften har en röst. Rösträtten är personlig.</li>
        <li>Årsmötet beslutar bland annat om verksamhetsberättelse, ansvarsfrihet, medlemsavgift och val av styrelse och revisor.</li>
        <li>Extra föreningsmöte hålls när styrelsen finner det nödvändigt eller när minst en tredjedel av de röstberättigade medlemmarna skriftligen begär det.</li>
      </ul>
      <p>Allt som gäller möten, dagordning och beslut står i <a href="/stadgar">stadgarna</a>.</p>

      <h2>Frågor</h2>
      <p>Har du frågor om ett möte, eller vill du lämna något till styrelsen? Du når oss via <a href="/kontakt">kontaktsidan</a>.</p>
    </div>
  </div>
</Base>

<script>
  // The next published meeting is read from Supabase when the page opens, so a meeting added on /admin shows at once.
  // Plain fetch (not supabase-js), as on /bortaresor.
  import { SUPABASE_URL, SUPABASE_KEY } from '../data/supabase';
  import { el, externalLink } from '../lib/trips';
  import { fmtMeetingDay, fmtMeetingTime, stockholmDay, type Meeting } from '../lib/meetings';

  const box = document.getElementById('next-meeting')!;
  const none = () => box.replaceChildren(el('p', {}, 'Inget möte är utlyst just nu. Nästa möte annonseras här och i Facebook-gruppen.'));

  async function load() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/meetings?select=*&published=eq.true&meeting_date=gte.${stockholmDay()}&order=meeting_date.asc,meeting_time.asc&limit=1`, { headers: { apikey: SUPABASE_KEY } });
      if (!res.ok) throw new Error();
      const [m] = (await res.json()) as Meeting[];
      if (!m) return none();
      const notice = externalLink(m.notice_url);
      box.replaceChildren(
        el('div', { class: 'notice' },
          el('p', {}, el('strong', {}, m.kind)),
          el('p', {}, `${fmtMeetingDay(m.meeting_date)} kl. ${fmtMeetingTime(m.meeting_time)}`, el('br'), `Plats: ${m.place ?? 'meddelas senare'}`),
          m.note && el('p', {}, m.note),
          notice && el('p', {}, el('a', { href: notice, rel: 'noopener noreferrer' }, 'Se kallelse och dagordning')),
        ),
      );
    } catch {
      box.replaceChildren(el('p', {}, 'Det gick inte att hämta nästa möte just nu. Försök igen om en stund.'));
    }
  }
  load();
</script>
