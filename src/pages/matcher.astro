---
import Base from '../layouts/Base.astro';
import Mail from '../components/Mail.astro';
import { upcoming, results, matchesUpdated, fmtDay, fmtShortDay, fmtTime, fmtScore } from '../data/matches';
import PageHead from '../components/PageHead.astro';

const alla = upcoming();
// De fem närmaste matcherna visas direkt, resten ligger bakom "Fler matcher".
const kommande = alla.slice(0, 5);
const fler = alla.slice(5);
// Resultaten är sorterade med det senaste först. De fem senaste visas direkt.
const senaste = results.slice(0, 5);
const aldre = results.slice(5);

// Lägg till resor här. Anmälan hanteras tills vidare via e-post.
const resor: { motstandare: string; datum: string; avgang: string; transport: string; info?: string }[] = [];
const uppdaterad = matchesUpdated ? new Date(matchesUpdated).toLocaleString('sv-SE', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Stockholm' }) : null;
---
<Base title="Matcher" description="Spelschema och resultat för Almtuna IS.">
  <PageHead title="Matcher">
    <p class="lead prose">Spelschema och resultat för Almtuna IS A-lag i Hockeyallsvenskan. Uppdateras automatiskt.</p>
    <p class="meta prose"><a href="#kommande">Kommande</a> · <a href="#resultat">Resultat</a> · <a href="#bortaresor">Bortaresor</a></p>
  </PageHead>
  <div class="wrap page">
    <h2 id="kommande">Kommande</h2>
    {kommande.length === 0 ? (
      <p class="notice prose">Inga kommande matcher är inlagda just nu.</p>
    ) : (
      <>
        <ul class="list">
          {kommande.map((m) => (
            <li>
              <h3>{m.home} – {m.away}</h3>
              <span class="meta">{fmtDay(m.date)} · {fmtTime(m)} · {m.isHome ? 'Hemma' : 'Borta'}{m.venue ? ` · ${m.venue}` : ''}{m.kind === 'training' ? ' · Träningsmatch' : ''}</span>
            </li>
          ))}
        </ul>
        {fler.length > 0 && (
          <details class="more">
            <summary>Fler matcher ({fler.length})</summary>
            <ul class="list">
              {fler.map((m) => (
                <li>
                  <h3>{m.home} – {m.away}</h3>
                  <span class="meta">{fmtDay(m.date)} · {fmtTime(m)} · {m.isHome ? 'Hemma' : 'Borta'}{m.venue ? ` · ${m.venue}` : ''}{m.kind === 'training' ? ' · Träningsmatch' : ''}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )}

    {results.length > 0 && (
      <>
        <h2 class="section-gap" id="resultat">Resultat</h2>
        <ul class="list">
          {senaste.map((r) => (
            <li>
              <h3>{r.home} {fmtScore(r)} {r.away}</h3>
              <span class="meta">{fmtShortDay(r.date)}</span>
            </li>
          ))}
        </ul>
        {aldre.length > 0 && (
          <details class="more">
            <summary>Fler resultat ({aldre.length})</summary>
            <ul class="list">
              {aldre.map((r) => (
                <li>
                  <h3>{r.home} {fmtScore(r)} {r.away}</h3>
                  <span class="meta">{fmtShortDay(r.date)}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )}

    <h2 class="section-gap" id="bortaresor">Bortaresor</h2>
    <p class="prose">Följ med Almtuna IS på bortamatcherna och var med och skapa stämning i andras hallar.</p>
    {resor.length === 0 ? (
      <p class="notice prose">Mer information om nästa bortaresa kommer. Håll utkik här eller mejla <Mail /> om du har frågor eller funderingar.</p>
    ) : (
      <div class="cards">
        {resor.map((r) => (
          <article class="card">
            <h3>{r.motstandare}</h3>
            <p class="meta">{r.datum} · {r.transport}, avgång {r.avgang}</p>
            {r.info && <p>{r.info}</p>}
            <Mail class="button" subject={`Anmälan bortaresa ${r.motstandare}`}>Anmäl dig</Mail>
          </article>
        ))}
      </div>
    )}

    <h2 class="section-gap" id="scheman">Klubbens spelscheman</h2>
    <p class="prose">De officiella och alltid aktuella spelscheman finns hos klubben. Tider kan ändras.</p>
    <ul class="list">
      <li><h3><a href="https://www.almtuna.com/game-schedule?seasonUuid=ndcf81nlb3&seriesUuid=qQ9-594cW8OWD&gameTypeUuid=qQ9-af37Ti40B&completeSeason=all&homeAway=all&allGames=all" rel="noopener">A-laget</a></h3><span class="meta">Hockeyallsvenskan</span></li>
      <li><h3><a href="https://www.almtuna.com/game-schedule?seasonUuid=ndcf81nlb3&seriesUuid=qYE-42dTycW3f&gameTypeUuid=qQ9-af37Ti40B&completeSeason=all&homeAway=all&allGames=all" rel="noopener">Damlaget</a></h3></li>
      <li><h3><a href="https://www.almtuna.com/game-schedule?seasonUuid=ndcf81nlb3&seriesUuid=qV0-8wgHrHJmG&gameTypeUuid=qQ9-af37Ti40B&completeSeason=all&homeAway=all&allGames=all" rel="noopener">U20</a></h3></li>
    </ul>
    {uppdaterad && <p class="meta">Senast uppdaterad {uppdaterad}. Schema och resultat kommer från klubbens spelschema, kompletterat av en kalenderfil och <a href="https://www.thesportsdb.com/team/144401">TheSportsDB</a>. Tider kan ändras.</p>}
  </div>
</Base>
