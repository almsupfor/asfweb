---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { upcoming, fmtDay, fmtTime } from '../data/matches';
import { travelEstimate, fmtDuration, ARRIVE_BEFORE } from '../data/arenor';
import { MEETING_KINDS, MEETING_DAYS_BEFORE, TRIP_DAYS_BEFORE } from '../lib/meetings';
// Kommande bortamatcher i serien. Schemat byggs in när sajten byggs och uppdateras av schemat i deploy.yml.
const awayMatches = upcoming()
  .filter((m) => !m.isHome && m.kind === 'league')
  .map((m) => ({ m, travel: travelEstimate(m) }));
// Pre-filled draft for the Information box on a new trip. Text in [brackets] is filled in or removed per trip.
// Exposed as data-draft on the textarea and inserted when a match is picked, so a fresh form stays empty.
// infoDraft is for sign-up on the site. infoDraftExternal (data-draft-external) is used instead while an external link is filled in:
// sign-up happens elsewhere and payment is at the bus.
const infoDraft = `Sista anmälningsdag är [veckodag datum]. Resan genomförs vid tillräckligt många anmälda, och vi bekräftar [veckodag datum].

Anmälan är bindande efter bekräftelsen.

Du betalar inget nu. Information om betalning kommer efter bekräftelsen. [Du får den på den e-postadress du anmäler med.]

Matchbiljett ingår inte i priset och köps separat. [Mer information om biljetter kommer.]

Hemfärd sker direkt efter matchen.

Frågor? Kontakta oss på [e-post / Facebook-gruppen].`;
const infoDraftExternal = `Sista anmälningsdag är [veckodag datum]. Resan genomförs vid tillräckligt många anmälda, och vi bekräftar [veckodag datum].

Anmälan görs via länken.

Du betalar inget i förväg. Betalning sker på plats vid bussen. [Så här betalar du: Swish / kontant.]

Matchbiljett ingår inte i priset och köps separat. [Mer information om biljetter kommer.]

Hemfärd sker direkt efter matchen.

Frågor? Kontakta oss på [e-post / Facebook-gruppen].`;
---
<Base title="Admin" noindex>
  <PageHead title="Admin" />
  <div class="wrap page">
    <p class="notice prose" id="admin-status" role="status">Laddar …</p>

    <section id="login" class="prose" hidden>
      <h2>Logga in</h2>
      <p>Skriv din e-postadress, så skickar vi en inloggningslänk.</p>
      <form id="login-form" class="signup" novalidate>
        <div class="field">
          <label for="login-email">E-post</label>
          <input id="login-email" type="email" autocomplete="email" required />
        </div>
        <p class="form-error" id="login-error" role="alert" hidden></p>
        <p><button type="submit" class="button">Skicka inloggningslänk</button></p>
      </form>
    </section>

    <section id="panel" hidden>
      <p class="meta">Inloggad som <span id="who"></span>. <button type="button" class="link-button" id="logout">Logga ut</button></p>

      <div class="tabs" role="tablist" aria-label="Administration">
        <button type="button" role="tab" id="tab-trips" class="tab" aria-selected="true" aria-controls="pane-trips">Resor</button>
        <button type="button" role="tab" id="tab-meetings" class="tab" aria-selected="false" aria-controls="pane-meetings" tabindex="-1">Möten</button>
        <button type="button" role="tab" id="tab-members" class="tab" aria-selected="false" aria-controls="pane-members" tabindex="-1">Medlemmar</button>
      </div>

      <div role="tabpanel" id="pane-trips" aria-labelledby="tab-trips">
      <h2>Resor</h2>
      <p class="meta prose">En publicerad resa visas på sidan Bortaresor och i den gula remsan från {TRIP_DAYS_BEFORE} dagar före resan. Anmälan är möjlig så länge den är öppen och det finns lediga platser.</p>
      <div id="trips-admin"></div>

      <h2 class="section-gap" id="form-title">Ny resa</h2>
      <form id="trip-form" class="signup" novalidate>
        {awayMatches.length > 0 && (
          <div class="field">
            <label for="t-match">Välj kommande bortamatch (fyller i titel och datum)</label>
            <select id="t-match">
              <option value="">Annan resa, skriv själv</option>
              {awayMatches.map(({ m, travel }) => (
                <option value={`${m.date}|${m.home} – ${m.away}`} data-departure={travel?.departure} data-hint={travel ? `Restid ungefär ${fmtDuration(travel.busMinutes)} med buss, inklusive rast och marginal. För att vara på plats ${ARRIVE_BEFORE} minuter före nedsläpp (${travel.arrive}${travel.preliminary ? ', preliminär matchtid' : ''}) föreslås avgång ${travel.departure}. Justera vid behov.` : 'Ingen avgångstid föreslås för den här matchen (troligen pga. okänd ishall, färjetransport eller ej fastställd matchtid).'}>
                  {fmtDay(m.date)} · {m.home} – {m.away}{m.venue ? ` (${m.venue})` : ''} · {fmtTime(m)}
                </option>
              ))}
            </select>
            <p class="meta" id="t-match-hint" aria-live="polite" hidden></p>
          </div>
        )}
        <div class="field"><label for="t-title">Titel (till exempel Mora IK – Almtuna IS)</label><input id="t-title" type="text" maxlength="120" required /></div>
        <div class="field"><label for="t-date">Datum</label><input id="t-date" type="date" required /></div>
        <div class="field"><label for="t-time">Avgångstid</label><input id="t-time" type="time" /></div>
        <div class="field"><label for="t-place">Avgångsplats</label><input id="t-place" type="text" maxlength="120" value="Gränby ishall" /></div>
        <div class="field"><label for="t-pm">Pris för medlemmar (kr)</label><input id="t-pm" type="number" min="0" step="1" required /></div>
        <div class="field"><label for="t-po">Pris för övriga (kr)</label><input id="t-po" type="number" min="0" step="1" required /></div>
        <div class="field"><label for="t-cap">Antal platser</label><input id="t-cap" type="number" min="1" step="1" required /></div>
        <div class="field"><label for="t-info">Information (till exempel hur man betalar och var vi samlas)</label><textarea id="t-info" rows="5" maxlength="2000" data-draft={infoDraft} data-draft-external={infoDraftExternal}></textarea></div>
        <label class="check" for="t-pub"><input id="t-pub" type="checkbox" /><span>Publicerad (syns för besökare)</span></label>
        <label class="check" for="t-open"><input id="t-open" type="checkbox" checked /><span>Anmälan öppen</span></label>
        <div class="field"><label for="t-ext">Extern länk för anmälan (valfritt). Om den är ifylld sker anmälan där i stället för i formuläret.</label><input id="t-ext" type="url" maxlength="300" placeholder="https://..." /></div>
        <p class="form-error" id="trip-error" role="alert" hidden></p>
        <p>
          <button type="submit" class="button" id="trip-save">Spara resa</button>
          <button type="button" class="button-secondary" id="trip-cancel" hidden>Avbryt ändring</button>
        </p>
      </form>
      </div>

      <div role="tabpanel" id="pane-meetings" aria-labelledby="tab-meetings" hidden>
      <h2>Möten</h2>
      <p class="meta prose">Ett publicerat möte visas på sidan Möten och i den gula remsan från {MEETING_DAYS_BEFORE} dagar före mötet.</p>
      <div id="meetings-admin"></div>

      <h2 class="section-gap" id="meeting-form-title">Nytt möte</h2>
      <form id="meeting-form" class="signup" novalidate>
        <div class="field">
          <label for="m-kind">Typ av möte</label>
          <select id="m-kind">
            {MEETING_KINDS.map((k) => <option value={k}>{k}</option>)}
          </select>
        </div>
        <div class="field"><label for="m-date">Datum</label><input id="m-date" type="date" required /></div>
        <div class="field"><label for="m-time">Tid</label><input id="m-time" type="time" required /></div>
        <div class="field"><label for="m-place">Plats</label><input id="m-place" type="text" maxlength="120" /></div>
        <div class="field"><label for="m-url">Länk till kallelsen (valfritt, till exempel inlägget i Facebook-gruppen)</label><input id="m-url" type="url" maxlength="300" placeholder="https://..." /></div>
        <div class="field"><label for="m-note">Anmärkning (valfritt)</label><textarea id="m-note" rows="3" maxlength="500"></textarea></div>
        <label class="check" for="m-pub"><input id="m-pub" type="checkbox" /><span>Publicerad (syns för besökare)</span></label>
        <p class="form-error" id="meeting-error" role="alert" hidden></p>
        <p>
          <button type="submit" class="button" id="meeting-save">Spara möte</button>
          <button type="button" class="button-secondary" id="meeting-cancel" hidden>Avbryt ändring</button>
        </p>
      </form>
      </div>

      <div role="tabpanel" id="pane-members" aria-labelledby="tab-members" hidden>
      <h2>Medlemmar</h2>
      <p class="meta prose">Medlemsavgiften gäller en säsong, 1 juli till 30 juni. Uppgifterna syns bara för administratörer. Ta bort medlemmar som inte förnyat senast den 30 juni, så som det står i integritetspolicyn. Borttagning går inte att ångra, så exportera gärna en CSV-fil först. Knappen "Ta bort medlem" finns under "Mer" på varje medlem.</p>
      <p class="meta" id="members-summary" aria-live="polite"></p>
      <p class="admin-actions">
        <button type="button" class="button-secondary" id="members-csv">Exportera alla (CSV)</button>
        <button type="button" class="button-secondary" id="members-mail">Kopiera e-post till medlemsbrev</button>
        <button type="button" class="button-secondary" id="members-confirm-all">Skicka bekräftelse till alla obekräftade</button>
      </p>
      <p class="meta prose">Bekräftelsen är ett mejl där medlemmen kontrollerar sin adress och väljer om hen vill ha medlemsbrev. Den skickas inte till den som är markerad med "inga medlemsbrev".</p>
      <div id="members-admin"></div>

      <h2 class="section-gap" id="member-form-title">Ny medlem</h2>
      <form id="member-form" class="signup" novalidate>
        <div class="field"><label for="mb-first">Förnamn</label><input id="mb-first" type="text" maxlength="80" autocomplete="off" required /></div>
        <div class="field"><label for="mb-last">Efternamn</label><input id="mb-last" type="text" maxlength="80" autocomplete="off" required /></div>
        <div class="field"><label for="mb-email">E-post</label><input id="mb-email" type="email" maxlength="200" autocomplete="off" required /></div>
        <div class="field"><label for="mb-season">Betald säsong</label><select id="mb-season"></select></div>
        <label class="check" for="mb-mail"><input id="mb-mail" type="checkbox" /><span>Vill ha medlemsbrev (personen har sagt ja)</span></label>
        <div class="field"><label for="mb-note">Anteckning (valfritt, till exempel att avgiften betalats kontant)</label><textarea id="mb-note" rows="2" maxlength="500"></textarea></div>
        <p class="form-error" id="member-error" role="alert" hidden></p>
        <p>
          <button type="submit" class="button" id="member-save">Spara medlem</button>
          <button type="button" class="button-secondary" id="member-cancel" hidden>Avbryt ändring</button>
        </p>
      </form>
      </div>
    </section>
  </div>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { el, externalLink, fmtTripDate, kr, type Trip } from '../lib/trips';
  import { fmtMeetingDay, fmtMeetingTime, type Meeting } from '../lib/meetings';
  import { isActive, seasonLabel, seasonStart, type Member } from '../lib/members';
  import type { Session } from '@supabase/supabase-js';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = $('admin-status');
  const loginSection = $('login');
  const panel = $('panel');
  const tripsBox = $('trips-admin');
  const tripForm = $<HTMLFormElement>('trip-form');
  const tripError = $('trip-error');

  let editingId: string | null = null;
  // undefined until the first session check has run, so "nobody is logged in" is also handled once.
  let currentUser: string | null | undefined = undefined;

  interface Booking {
    id: string;
    email: string;
    phone: string;
    total_price: number;
    paid: boolean;
    created_at: string;
    passengers: { first_name: string; last_name: string; is_member: boolean; price: number }[];
  }

  // ---- Login -------------------------------------------------------------

  async function route(session: Session | null) {
    const id = session?.user.id ?? null;
    if (id === currentUser) return;
    currentUser = id;
    if (!session) {
      panel.hidden = true;
      loginSection.hidden = false;
      status.hidden = true;
      return;
    }
    loginSection.hidden = true;
    const { data } = await supabase.rpc('am_i_admin');
    if (data !== true) {
      panel.hidden = true;
      status.textContent = `Du är inloggad som ${session.user.email}, men har inte administratörsbehörighet.`;
      status.hidden = false;
      status.append(' ', logoutButton());
      return;
    }
    status.hidden = true;
    $('who').textContent = session.user.email ?? '';
    panel.hidden = false;
    await Promise.all([loadTrips(), loadMeetings(), loadMembers()]);
  }

  function logoutButton() {
    const b = el('button', { type: 'button', class: 'link-button' }, 'Logga ut');
    b.addEventListener('click', () => supabase.auth.signOut());
    return b;
  }
  $('logout').addEventListener('click', () => supabase.auth.signOut());

  $('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const box = $('login-error');
    const email = $<HTMLInputElement>('login-email').value.trim().toLowerCase();
    box.hidden = true;
    if (!email) {
      box.textContent = 'Skriv din e-postadress.';
      box.hidden = false;
      return;
    }
    const { error } = await supabase.auth.signInWithOtp({ email, options: { shouldCreateUser: false, emailRedirectTo: `${location.origin}/admin/` } });
    if (error) {
      box.textContent =
        error.status === 429 || error.code === 'over_email_send_rate_limit'
          ? 'För många inloggningslänkar har skickats på kort tid. Vänta en stund och försök igen, och använd den senaste länken i mejlet.'
          : 'Det gick inte att skicka länken. Kontrollera adressen, eller be en administratör bjuda in dig.';
      box.hidden = false;
      return;
    }
    status.textContent = `Vi har skickat en inloggningslänk till ${email}. Öppna den i den här webbläsaren.`;
    status.hidden = false;
  });

  // A failed login link (already used or expired) puts the error in the URL hash; show it instead.
  const hashParams = new URLSearchParams(location.hash.slice(1));
  if (hashParams.get('error_code')) {
    const expired = hashParams.get('error_code') === 'otp_expired';
    $('login-error').textContent = expired
      ? 'Inloggningslänken har redan använts eller har gått ut. Skriv din e-postadress och skicka en ny.'
      : 'Inloggningen misslyckades. Försök igen.';
    $('login-error').hidden = false;
    history.replaceState(null, '', location.pathname);
  }

  // Sign out automatically this long after the magic link was used.
  const MAX_SESSION_MS = 12 * 60 * 60 * 1000;
  function expired(session: Session | null) {
    const at = session?.user.last_sign_in_at;
    return !!at && Date.now() - new Date(at).getTime() > MAX_SESSION_MS;
  }
  async function checkExpiry() {
    const { data } = await supabase.auth.getSession();
    if (expired(data.session)) await supabase.auth.signOut();
  }

  supabase.auth.getSession().then(({ data }) => (expired(data.session) ? supabase.auth.signOut() : route(data.session)));
  supabase.auth.onAuthStateChange((_event, session) => route(session));
  setInterval(checkExpiry, 60_000);

  // ---- Tabs ---------------------------------------------------------------

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  function selectTab(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      $(t.getAttribute('aria-controls')!).hidden = !on;
    }
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      selectTab(next);
      next.focus();
    });
  });

  // ---- Trips --------------------------------------------------------------

  async function loadTrips() {
    const [tripsRes, passRes] = await Promise.all([
      supabase.from('trips').select('*').order('trip_date', { ascending: false }),
      supabase.from('passengers').select('trip_id'),
    ]);
    if (tripsRes.error) {
      tripsBox.replaceChildren(el('p', { class: 'notice' }, 'Det gick inte att hämta resorna.'));
      return;
    }
    const counts = new Map<string, number>();
    for (const p of (passRes.data ?? []) as { trip_id: string }[]) counts.set(p.trip_id, (counts.get(p.trip_id) ?? 0) + 1);
    const trips = (tripsRes.data ?? []) as Trip[];
    if (trips.length === 0) {
      tripsBox.replaceChildren(el('p', { class: 'notice prose' }, 'Inga resor är skapade än. Skapa en nedan.'));
      return;
    }
    tripsBox.replaceChildren(...trips.map((t) => tripCard(t, counts.get(t.id) ?? 0)));
  }

  function tripCard(t: Trip, taken: number) {
    const bookings = el('div', { class: 'admin-bookings', hidden: '' });
    const show = el('button', { type: 'button', class: 'button-secondary' }, 'Visa anmälda');
    show.addEventListener('click', async () => {
      if (!bookings.hidden) {
        bookings.hidden = true;
        show.textContent = 'Visa anmälda';
        return;
      }
      await loadBookings(t, bookings);
      bookings.hidden = false;
      show.textContent = 'Dölj anmälda';
    });
    const edit = el('button', { type: 'button', class: 'button-secondary' }, 'Redigera');
    edit.addEventListener('click', () => startEdit(t));
    const del = el('button', { type: 'button', class: 'button-secondary' }, 'Ta bort resa');
    del.addEventListener('click', async () => {
      if (!confirm(`Ta bort "${t.title}" och alla anmälningar till den? Det går inte att ångra.`)) return;
      const { error } = await supabase.from('trips').delete().eq('id', t.id);
      if (error) alert('Det gick inte att ta bort resan.');
      await loadTrips();
    });
    return el('div', { class: 'admin-trip' },
      el('h3', {}, t.title),
      el('p', { class: 'meta' }, `${fmtTripDate(t.trip_date)} · ${t.published ? 'Publicerad' : 'Utkast'} · ${t.is_open ? 'Öppen' : 'Stängd'} · ${t.external_url ? 'Anmälan via extern länk' : `Anmälda ${taken} / ${t.capacity}`} · Medlem ${kr(t.price_member)}, övriga ${kr(t.price_other)}`),
      el('p', { class: 'admin-actions' }, show, edit, del),
      bookings,
    );
  }

  async function loadBookings(t: Trip, box: HTMLElement) {
    const { data, error } = await supabase
      .from('bookings')
      .select('id, email, phone, total_price, paid, created_at, passengers(first_name, last_name, is_member, price)')
      .eq('trip_id', t.id)
      .order('created_at');
    if (error) {
      box.replaceChildren(el('p', { class: 'notice' }, 'Det gick inte att hämta anmälningarna.'));
      return;
    }
    const bookings = (data ?? []) as Booking[];
    if (bookings.length === 0) {
      box.replaceChildren(el('p', { class: 'meta' }, 'Ingen har anmält sig via webbsidan.'));
      return;
    }
    const rows: Node[] = [];
    for (const b of bookings) {
      const del = el('button', { type: 'button', class: 'link-button' }, 'Ta bort anmälan');
      del.addEventListener('click', async () => {
        if (!confirm('Ta bort hela anmälan? Det går inte att ångra.')) return;
        await supabase.from('bookings').delete().eq('id', b.id);
        await loadTrips();
      });
      const paid = el('input', { type: 'checkbox', 'aria-label': `Betald, referens ${b.id.slice(0, 8).toUpperCase()}` });
      paid.checked = b.paid;
      paid.addEventListener('change', async () => {
        const want = paid.checked;
        paid.disabled = true;
        const { error: upErr } = await supabase.from('bookings').update({ paid: want }).eq('id', b.id);
        paid.disabled = false;
        if (upErr) {
          paid.checked = !want;
          alert('Det gick inte att spara betalstatus.');
          return;
        }
        b.paid = want;
      });
      b.passengers.forEach((p, i) =>
        rows.push(
          el('tr', {},
            el('th', { scope: 'row' }, `${p.first_name} ${p.last_name}`),
            el('td', {}, p.is_member ? 'Medlem' : 'Övrig'),
            el('td', {}, kr(p.price)),
            el('td', {}, i === 0 ? b.email : ''),
            el('td', {}, i === 0 ? b.phone : ''),
            el('td', {}, i === 0 ? new Date(b.created_at).toLocaleString('sv-SE', { dateStyle: 'short', timeStyle: 'short' }) : ''),
            el('td', {}, i === 0 ? b.id.slice(0, 8).toUpperCase() : ''),
            el('td', {}, i === 0 ? paid : ''),
            el('td', {}, i === 0 ? del : ''),
          ),
        ),
      );
    }
    const csv = el('button', { type: 'button', class: 'button-secondary' }, 'Exportera som CSV');
    csv.addEventListener('click', () => downloadCsv(t, bookings));
    box.replaceChildren(
      el('div', { class: 'table-scroll', tabindex: '0', role: 'region', 'aria-label': 'Anmälda' },
        el('table', { class: 'standings admin-table' },
          el('thead', {}, el('tr', {}, ...['Namn', 'Typ', 'Pris', 'E-post', 'Mobil', 'Anmäld', 'Referens', 'Betald', ''].map((h) => el('th', { scope: 'col' }, h)))),
          el('tbody', {}, ...rows),
        ),
      ),
      el('p', {}, csv),
    );
  }

  function downloadCsv(t: Trip, bookings: Booking[]) {
    const q = (s: string | number) => `"${String(s).replace(/"/g, '""')}"`;
    const lines = [['Namn', 'Typ', 'Pris', 'E-post', 'Mobil', 'Anmäld', 'Referens', 'Betald'].map(q).join(';')];
    for (const b of bookings) {
      for (const p of b.passengers) {
        lines.push([`${p.first_name} ${p.last_name}`, p.is_member ? 'Medlem' : 'Övrig', p.price, b.email, b.phone, b.created_at, b.id.slice(0, 8).toUpperCase(), b.paid ? 'Ja' : 'Nej'].map(q).join(';'));
      }
    }
    // The leading BOM makes Excel read the file as UTF-8.
    const blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const a = el('a', { href: URL.createObjectURL(blob), download: `anmalda-${t.trip_date}.csv` });
    document.body.append(a);
    a.click();
    a.remove();
  }

  // ---- Create and edit ------------------------------------------------------

  const f = (id: string) => $<HTMLInputElement>(id);

  function startEdit(t: Trip) {
    editingId = t.id;
    $('form-title').textContent = 'Redigera resa';
    f('t-title').value = t.title;
    f('t-date').value = t.trip_date;
    f('t-time').value = t.departure_time?.slice(0, 5) ?? '';
    f('t-place').value = t.departure_place ?? '';
    f('t-pm').value = String(t.price_member);
    f('t-po').value = String(t.price_other);
    f('t-cap').value = String(t.capacity);
    $<HTMLTextAreaElement>('t-info').value = t.info ?? '';
    f('t-ext').value = t.external_url ?? '';
    f('t-pub').checked = t.published;
    f('t-open').checked = t.is_open;
    $('trip-cancel').hidden = false;
    tripForm.scrollIntoView({ block: 'start' });
  }

  function resetForm() {
    editingId = null;
    tripForm.reset();
    f('t-open').checked = true;
    const pick = document.getElementById('t-match') as HTMLSelectElement | null;
    if (pick) pick.value = '';
    $('t-match-hint').hidden = true;
    $('form-title').textContent = 'Ny resa';
    $('trip-cancel').hidden = true;
    tripError.hidden = true;
  }
  $('trip-cancel').addEventListener('click', resetForm);

  // Picking an upcoming away match fills in title, date and a suggested departure time (when the arena is known).
  $<HTMLSelectElement>('t-match')?.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement;
    const [date, title] = select.value.split('|');
    const hint = $('t-match-hint');
    hint.hidden = !date;
    if (!date) return;
    const option = select.selectedOptions[0];
    f('t-title').value = title;
    f('t-date').value = date;
    hint.textContent = option.dataset.hint ?? '';
    if (option.dataset.departure) f('t-time').value = option.dataset.departure;
    const info = $<HTMLTextAreaElement>('t-info');
    if (!info.value.trim()) info.value = draftFor(f('t-ext').value.trim() ? 'external' : 'form');
  });

  // The information template that fits how sign-up works for this trip.
  const draftFor = (kind: 'form' | 'external') => $<HTMLTextAreaElement>('t-info').dataset[kind === 'external' ? 'draftExternal' : 'draft'] ?? '';

  // Adding or removing the external link swaps the template, but only while the text is still an untouched template.
  f('t-ext').addEventListener('input', () => {
    const want = f('t-ext').value.trim() ? 'external' : 'form';
    const box = $<HTMLTextAreaElement>('t-info');
    if (box.value === draftFor(want === 'external' ? 'form' : 'external')) box.value = draftFor(want);
  });

  tripForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = editingId ? 'Spara ändringarna i resan?' : 'Skapa resan och visa den på sajten?';
    if (!confirm(question)) return;
    tripError.hidden = true;
    const row = {
      title: f('t-title').value.trim(),
      trip_date: f('t-date').value,
      departure_time: f('t-time').value || null,
      departure_place: f('t-place').value.trim() || null,
      price_member: Number(f('t-pm').value),
      price_other: Number(f('t-po').value),
      capacity: Number(f('t-cap').value),
      info: $<HTMLTextAreaElement>('t-info').value.trim() || null,
      external_url: f('t-ext').value.trim() || null,
      published: f('t-pub').checked,
      is_open: f('t-open').checked,
    };
    if (!row.title || !row.trip_date || !Number.isFinite(row.price_member) || !Number.isFinite(row.price_other) || !(row.capacity > 0) || f('t-pm').value === '' || f('t-po').value === '') {
      tripError.textContent = 'Fyll i titel, datum, båda priserna och antal platser.';
      tripError.hidden = false;
      return;
    }
    if (row.external_url && !externalLink(row.external_url)) {
      tripError.textContent = 'Den externa länken måste börja med https://.';
      tripError.hidden = false;
      return;
    }
    // Placeholders such as [veckodag datum] must not reach visitors. A draft (not published) may keep them.
    if (row.published && row.info && /\[[^\]]*\]/.test(row.info)) {
      tripError.textContent = 'Informationen innehåller fortfarande text inom [hakparentes]. Fyll i eller ta bort den innan du publicerar, eller spara som utkast.';
      tripError.hidden = false;
      return;
    }
    const { error } = editingId
      ? await supabase.from('trips').update(row).eq('id', editingId)
      : await supabase.from('trips').insert(row);
    if (error) {
      tripError.textContent = 'Det gick inte att spara resan.';
      tripError.hidden = false;
      return;
    }
    resetForm();
    await loadTrips();
  });

  // ---- Meetings -------------------------------------------------------------

  const meetingsBox = $('meetings-admin');
  const meetingForm = $<HTMLFormElement>('meeting-form');
  const meetingError = $('meeting-error');
  let editingMeetingId: string | null = null;

  async function loadMeetings() {
    const { data, error } = await supabase.from('meetings').select('*').order('meeting_date', { ascending: false });
    if (error) {
      meetingsBox.replaceChildren(el('p', { class: 'notice' }, 'Det gick inte att hämta mötena.'));
      return;
    }
    const meetings = (data ?? []) as Meeting[];
    if (meetings.length === 0) {
      meetingsBox.replaceChildren(el('p', { class: 'notice prose' }, 'Inga möten är inlagda än. Lägg till ett nedan.'));
      return;
    }
    meetingsBox.replaceChildren(...meetings.map(meetingCard));
  }

  function meetingCard(m: Meeting) {
    const edit = el('button', { type: 'button', class: 'button-secondary' }, 'Redigera');
    edit.addEventListener('click', () => startEditMeeting(m));
    const del = el('button', { type: 'button', class: 'button-secondary' }, 'Ta bort möte');
    del.addEventListener('click', async () => {
      if (!confirm(`Ta bort ${m.kind.toLowerCase()} ${m.meeting_date}? Det går inte att ångra.`)) return;
      const { error } = await supabase.from('meetings').delete().eq('id', m.id);
      if (error) alert('Det gick inte att ta bort mötet.');
      await loadMeetings();
    });
    return el('div', { class: 'admin-trip' },
      el('h3', {}, m.kind),
      el('p', { class: 'meta' }, `${fmtMeetingDay(m.meeting_date)} kl. ${fmtMeetingTime(m.meeting_time)} · ${m.place ?? 'Plats meddelas senare'} · ${m.published ? 'Publicerat' : 'Utkast'}`),
      el('p', { class: 'admin-actions' }, edit, del),
    );
  }

  const mf = (id: string) => $<HTMLInputElement>(id);

  function startEditMeeting(m: Meeting) {
    editingMeetingId = m.id;
    $('meeting-form-title').textContent = 'Redigera möte';
    $<HTMLSelectElement>('m-kind').value = m.kind;
    mf('m-date').value = m.meeting_date;
    mf('m-time').value = fmtMeetingTime(m.meeting_time);
    mf('m-place').value = m.place ?? '';
    mf('m-url').value = m.notice_url ?? '';
    $<HTMLTextAreaElement>('m-note').value = m.note ?? '';
    mf('m-pub').checked = m.published;
    $('meeting-cancel').hidden = false;
    meetingForm.scrollIntoView({ block: 'start' });
  }

  function resetMeetingForm() {
    editingMeetingId = null;
    meetingForm.reset();
    $('meeting-form-title').textContent = 'Nytt möte';
    $('meeting-cancel').hidden = true;
    meetingError.hidden = true;
  }
  $('meeting-cancel').addEventListener('click', resetMeetingForm);

  meetingForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!confirm(editingMeetingId ? 'Spara ändringarna i mötet?' : 'Skapa mötet?')) return;
    meetingError.hidden = true;
    const row = {
      kind: $<HTMLSelectElement>('m-kind').value,
      meeting_date: mf('m-date').value,
      meeting_time: mf('m-time').value,
      place: mf('m-place').value.trim() || null,
      notice_url: mf('m-url').value.trim() || null,
      note: $<HTMLTextAreaElement>('m-note').value.trim() || null,
      published: mf('m-pub').checked,
    };
    const fail = (text: string) => {
      meetingError.textContent = text;
      meetingError.hidden = false;
    };
    if (!row.meeting_date || !row.meeting_time) return fail('Fyll i datum och tid.');
    if (row.notice_url && !externalLink(row.notice_url)) return fail('Länken måste börja med https://.');
    const { error } = editingMeetingId
      ? await supabase.from('meetings').update(row).eq('id', editingMeetingId)
      : await supabase.from('meetings').insert(row);
    if (error) return fail('Det gick inte att spara mötet.');
    resetMeetingForm();
    await loadMeetings();
  });

  // ---- Members --------------------------------------------------------------

  const membersBox = $('members-admin');
  const memberForm = $<HTMLFormElement>('member-form');
  const memberError = $('member-error');
  const mb = (id: string) => $<HTMLInputElement>(id);
  const thisSeason = seasonStart();
  let editingMemberId: string | null = null;
  let members: Member[] = [];

  const seasonSelect = $<HTMLSelectElement>('mb-season');
  function fillSeasons() {
    const opts: [string, string][] = [
      [String(thisSeason), `${seasonLabel(thisSeason)} (säsongen som pågår)`],
      [String(thisSeason + 1), `${seasonLabel(thisSeason + 1)} (nästa säsong)`],
      [String(thisSeason - 1), `${seasonLabel(thisSeason - 1)} (förra säsongen)`],
      ['', 'Inte betald'],
    ];
    seasonSelect.replaceChildren(...opts.map(([value, label]) => el('option', { value }, label)));
    seasonSelect.value = String(thisSeason);
  }
  fillSeasons();

  async function loadMembers() {
    const { data, error } = await supabase.from('members').select('*').order('last_name').order('first_name');
    if (error) {
      membersBox.replaceChildren(el('p', { class: 'notice' }, 'Det gick inte att hämta medlemmarna. Har databasen uppdaterats med tabellen för medlemmar?'));
      return;
    }
    members = (data ?? []) as Member[];
    const active = members.filter((m) => isActive(m));
    const mailable = active.filter((m) => m.wants_mail);
    const unconfirmed = members.filter((m) => !m.email_confirmed_at).length;
    $('members-summary').textContent = `${active.length} medlemmar för säsongen ${seasonLabel(thisSeason)}, varav ${mailable.length} vill ha medlemsbrev. ${members.length - active.length} har ingen betald avgift för säsongen. ${unconfirmed} har inte bekräftat sin e-post.`;
    if (members.length === 0) {
      membersBox.replaceChildren(el('p', { class: 'notice prose' }, 'Inga medlemmar är inlagda än. Lägg till en nedan.'));
      return;
    }
    membersBox.replaceChildren(...members.map(memberCard));
  }

  function memberCard(m: Member) {
    const active = isActive(m);
    const paidText = m.paid_season == null ? 'Inte betald' : `Betald ${seasonLabel(m.paid_season)}`;
    const actions: HTMLElement[] = [];
    if (!active) {
      const pay = el('button', { type: 'button', class: 'button-secondary' }, `Markera betald ${seasonLabel(thisSeason)}`);
      pay.addEventListener('click', async () => {
        const { error } = await supabase.from('members').update({ paid_season: thisSeason }).eq('id', m.id);
        if (error) alert('Det gick inte att spara.');
        await loadMembers();
      });
      actions.push(pay);
    }
    const edit = el('button', { type: 'button', class: 'button-secondary' }, 'Redigera');
    edit.addEventListener('click', () => startEditMember(m));
    const del = el('button', { type: 'button', class: 'button-secondary' }, 'Ta bort medlem');
    del.addEventListener('click', async () => {
      // Typing the surname makes an accidental delete very unlikely. Not case sensitive; cancel or a mismatch leaves the member in place.
      const typed = prompt(`Ta bort ${m.first_name} ${m.last_name} ur registret? Det går inte att ångra.\n\nSkriv efternamnet "${m.last_name}" för att bekräfta:`);
      if (typed === null) return;
      if (typed.trim().toLowerCase() !== m.last_name.trim().toLowerCase()) return alert('Efternamnet stämde inte, så medlemmen togs inte bort.');
      const { error } = await supabase.from('members').delete().eq('id', m.id);
      if (error) alert('Det gick inte att ta bort medlemmen.');
      await loadMembers();
    });
    // Deleting is kept behind "Mer" so it is not one stray click away from Redigera.
    del.hidden = true;
    const more = el('button', { type: 'button', class: 'button-secondary', 'aria-expanded': 'false' }, 'Mer');
    more.addEventListener('click', () => {
      del.hidden = !del.hidden;
      more.setAttribute('aria-expanded', String(!del.hidden));
      more.textContent = del.hidden ? 'Mer' : 'Färre';
    });
    // Mailing a confirmation makes no sense for someone who is confirmed or who has said no to letters.
    if (!m.email_confirmed_at && m.wants_mail) {
      const send = el('button', { type: 'button', class: 'button-secondary' }, m.confirmation_sent_at ? 'Skicka bekräftelse igen' : 'Skicka bekräftelse');
      send.addEventListener('click', () => sendConfirmations([m]));
      actions.unshift(send);
    }
    actions.push(edit, more, del);
    const confirmText = m.email_confirmed_at
      ? `E-post bekräftad ${new Date(m.email_confirmed_at).toLocaleDateString('sv-SE')}`
      : m.confirmation_sent_at
        ? `Bekräftelse skickad ${new Date(m.confirmation_sent_at).toLocaleDateString('sv-SE')}, ej bekräftad`
        : 'E-post ej bekräftad';
    return el('div', { class: 'admin-trip' },
      el('h3', {}, `${m.first_name} ${m.last_name}`),
      el('p', { class: 'meta' }, `${m.email} · ${confirmText} · ${paidText}${active ? '' : ' (ingen giltig avgift just nu)'} · ${m.wants_mail ? 'Vill ha medlemsbrev' : 'Inga medlemsbrev'}${m.note ? ` · ${m.note}` : ''}`),
      el('p', { class: 'admin-actions' }, ...actions),
    );
  }

  // Asks the send-member-confirmation function (admin-only, checked there too) to mail the given members.
  async function sendConfirmations(list: Member[]) {
    if (list.length === 0) return alert('Det finns ingen att skicka till. Alla är bekräftade eller har sagt nej till medlemsbrev.');
    const who = list.length === 1 ? `${list[0].first_name} ${list[0].last_name} (${list[0].email})` : `${list.length} medlemmar`;
    if (!confirm(`Skicka bekräftelsemejl till ${who}?`)) return;
    const { data, error } = await supabase.functions.invoke('send-member-confirmation', { body: { ids: list.map((m) => m.id) } });
    if (error) {
      const notSetUp = (error as { context?: { status?: number } }).context?.status;
      alert(notSetUp === 503 || notSetUp === 404 ? 'Utskicket är inte uppsatt än (e-posttjänsten eller funktionen saknas).' : 'Det gick inte att skicka bekräftelsen.');
      return;
    }
    const failed = (data?.failed ?? []) as { email: string }[];
    alert(`${data?.sent ?? 0} mejl skickades.${failed.length ? ` Det gick inte att skicka till: ${failed.map((f) => f.email).join(', ')}. Kontrollera adressen.` : ''}`);
    await loadMembers();
  }

  $('members-confirm-all').addEventListener('click', () => {
    const list = members.filter((m) => !m.email_confirmed_at && m.wants_mail);
    if (list.length > 50) return alert('Det är fler än 50. Skicka i omgångar, en medlem i taget.');
    sendConfirmations(list);
  });

  function startEditMember(m: Member) {
    editingMemberId = m.id;
    $('member-form-title').textContent = 'Redigera medlem';
    mb('mb-first').value = m.first_name;
    mb('mb-last').value = m.last_name;
    mb('mb-email').value = m.email;
    // A season outside the usual three (for example an older one) is kept as its own option so it is not lost on save.
    if (m.paid_season != null && ![...seasonSelect.options].some((o) => o.value === String(m.paid_season))) {
      seasonSelect.append(el('option', { value: String(m.paid_season) }, seasonLabel(m.paid_season)));
    }
    seasonSelect.value = m.paid_season == null ? '' : String(m.paid_season);
    mb('mb-mail').checked = m.wants_mail;
    $<HTMLTextAreaElement>('mb-note').value = m.note ?? '';
    $('member-cancel').hidden = false;
    memberForm.scrollIntoView({ block: 'start' });
  }

  function resetMemberForm() {
    editingMemberId = null;
    memberForm.reset();
    fillSeasons();
    mb('mb-mail').checked = false; // off by default: only tick it when the person has actually said yes
    $('member-form-title').textContent = 'Ny medlem';
    $('member-cancel').hidden = true;
    memberError.hidden = true;
  }
  $('member-cancel').addEventListener('click', resetMemberForm);

  memberForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    memberError.hidden = true;
    const fail = (text: string) => {
      memberError.textContent = text;
      memberError.hidden = false;
    };
    const row = {
      first_name: mb('mb-first').value.trim(),
      last_name: mb('mb-last').value.trim(),
      email: mb('mb-email').value.trim(),
      paid_season: seasonSelect.value === '' ? null : Number(seasonSelect.value),
      wants_mail: mb('mb-mail').checked,
      note: $<HTMLTextAreaElement>('mb-note').value.trim() || null,
    };
    if (!row.first_name || !row.last_name) return fail('Fyll i förnamn och efternamn.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(row.email)) return fail('Skriv en giltig e-postadress. E-post krävs för att kunna nå medlemmen.');
    const { error } = editingMemberId
      ? await supabase.from('members').update(row).eq('id', editingMemberId)
      : await supabase.from('members').insert(row);
    if (error) return fail(error.code === '23505' ? 'Den e-postadressen finns redan i registret.' : 'Det gick inte att spara medlemmen.');
    resetMemberForm();
    await loadMembers();
  });

  $('members-csv').addEventListener('click', () => {
    const q = (s: string | number | null) => `"${String(s ?? '').replace(/"/g, '""')}"`;
    const lines = [['Förnamn', 'Efternamn', 'E-post', 'Betald säsong', 'Giltig nu', 'Medlemsbrev', 'Anteckning'].map(q).join(';')];
    for (const m of members) {
      lines.push([m.first_name, m.last_name, m.email, m.paid_season == null ? '' : seasonLabel(m.paid_season), isActive(m) ? 'Ja' : 'Nej', m.wants_mail ? 'Ja' : 'Nej', m.note].map(q).join(';'));
    }
    const blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const a = el('a', { href: URL.createObjectURL(blob), download: `medlemmar-${new Date().toISOString().slice(0, 10)}.csv` });
    document.body.append(a);
    a.click();
    a.remove();
  });

  // Addresses for a membership letter: only current members who have said yes to letters. Paste them in the BCC field, never To or Cc.
  $('members-mail').addEventListener('click', async () => {
    const list = members.filter((m) => isActive(m) && m.wants_mail).map((m) => m.email);
    if (list.length === 0) return alert('Ingen giltig medlem har sagt ja till medlemsbrev.');
    try {
      await navigator.clipboard.writeText(list.join(', '));
      alert(`${list.length} e-postadresser är kopierade. Klistra in dem i fältet Dold kopia (BCC), aldrig i Till eller Kopia.`);
    } catch {
      prompt('Kopiera adresserna och klistra in dem i fältet Dold kopia (BCC):', list.join(', '));
    }
  });
</script>
