---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import PageHead from '../components/PageHead.astro';
---
<Base title="Om oss">
  <PageHead title="Om oss">
    <p class="lead">{site.name} är en ideell förening för alla som stöttar ishockeylaget Almtuna IS från Uppsala.</p>
  </PageHead>
  <div class="wrap page">
    <div class="prose">
      <p>Vi arbetar för stämning på läktaren, gemenskap bland supportrar och att fler hittar till hallen. Föreningen är fristående från Almtuna IS.</p>
      <h2>Vad vi gör</h2>
      <ul>
        <li>Skapar stämning vid hemma- och bortamatcher</li>
        <li>Arrangerar bortaresor</li>
        <li>Samlar historia, sånger och tips för supportrar</li>
      </ul>
      <h2>Föreningen</h2>
      <p>Föreningen har org.nr {site.orgNr}. <br /> Du hittar föreningens stadgar <a href="/stadgar">här</a>.</p>
      <h2>Styrelse</h2>
      <p>Styrelsen består av ordförande, sekreterare, kassör, två ledamöter och två suppleanter. Kontakta oss via <a href="/kontakt">kontaktsidan</a>.</p>
    </div>
  </div>
</Base>
