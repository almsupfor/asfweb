---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import LagNav from '../../components/LagNav.astro';
import { lagen, fulltNamn } from '../../data/lagen';

// Herrlaget ligger på /matcher. Här skapas sidorna för de andra lagen.
export function getStaticPaths() {
  return lagen
    .filter((l) => l.key !== 'herr')
    .map((l) => ({ params: { lag: l.matcher.split('/').pop() }, props: { lag: l } }));
}
const { lag } = Astro.props;
---
<Base title={`Matcher: ${lag.namn}`} description={`Spelschema för ${fulltNamn(lag)}.`}>
  <PageHead title="Matcher">
    <p class="lead prose">Spelschema och resultat för {fulltNamn(lag)}.</p>
    <LagNav current={lag.key} sida="matcher" />
  </PageHead>
  <div class="wrap page">
    <h2>{lag.namn}</h2>
    <p class="notice prose">Schema och resultat för {lag.namn} visas inte här än. Det officiella spelschemat finns hos klubben.</p>
    <ul class="list compact">
      <li><h3><a href={lag.schema} rel="noopener">Klubbens spelschema</a></h3><span class="meta">almtuna.com</span></li>
      <li><h3><a href={lag.href}>Tabell och lagsida</a></h3></li>
    </ul>
  </div>
</Base>
