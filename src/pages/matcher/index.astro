---
import Base from '../../layouts/Base.astro';
import { upcoming, results, matchesUpdated, fmtDay, fmtShortDay, fmtTime, fmtScore } from '../../data/matches';
import { lagen } from '../../data/lagen';
import { DIREKT } from '../../data/visning';
import PageHead from '../../components/PageHead.astro';
import LagNav from '../../components/LagNav.astro';

const alla = upcoming();
// De närmaste matcherna visas direkt, resten ligger bakom "Visa fler".
const kommande = alla.slice(0, DIREKT);
const fler = alla.slice(DIREKT);
// Resultaten är sorterade med det senaste först. De senaste visas direkt.
const senaste = results.slice(0, DIREKT);
const aldre = results.slice(DIREKT);

const herr = lagen.find((l) => l.key === 'herr')!;
const uppdaterad = matchesUpdated ? new Date(matchesUpdated).toLocaleString('sv-SE', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Stockholm' }) : null;
---
<Base title="Matcher" description="Spelschema och resultat för Almtuna IS.">
  <PageHead title="Matcher">
    <p class="lead prose">Spelschema och resultat för Almtuna IS herrlag i Hockeyallsvenskan.</p>
    <LagNav current="herr" sida="matcher" />
    <nav class="sub-nav" aria-label="På sidan">
      <a href="#kommande">Kommande</a>
      <a href="#resultat">Resultat</a>
      <a href="#infor-matchen">Inför matchen</a>
      <a href="/bortaresor">Bortaresor</a>
    </nav>
  </PageHead>
  <div class="wrap page">
    <h2 id="kommande">Kommande</h2>
    {kommande.length === 0 ? (
      <p class="notice prose">Inga kommande matcher är inlagda just nu.</p>
    ) : (
      <>
        <ul class="tiles">
          {kommande.map((m) => (
            <li>
              <h3>{m.home} – {m.away}</h3>
              <span class="meta">{fmtDay(m.date)} · {fmtTime(m)} · {m.isHome ? 'Hemma' : 'Borta'}{m.venue ? ` · ${m.venue}` : ''}{m.kind === 'training' ? ' · Träningsmatch' : ''}</span>
            </li>
          ))}
        </ul>
        {fler.length > 0 && (
          <details class="more">
            <summary><span class="s-closed">Visa fler ({fler.length})</span><span class="s-open">Visa färre</span></summary>
            <ul class="tiles">
              {fler.map((m) => (
                <li>
                  <h3>{m.home} – {m.away}</h3>
                  <span class="meta">{fmtDay(m.date)} · {fmtTime(m)} · {m.isHome ? 'Hemma' : 'Borta'}{m.venue ? ` · ${m.venue}` : ''}{m.kind === 'training' ? ' · Träningsmatch' : ''}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )}

    {results.length > 0 && (
      <>
        <h2 class="section-gap" id="resultat">Resultat</h2>
        <ul class="tiles">
          {senaste.map((r) => (
            <li>
              <h3>{r.home} {fmtScore(r)} {r.away}</h3>
              <span class="meta">{fmtShortDay(r.date)}</span>
            </li>
          ))}
        </ul>
        {aldre.length > 0 && (
          <details class="more">
            <summary><span class="s-closed">Visa fler ({aldre.length})</span><span class="s-open">Visa färre</span></summary>
            <ul class="tiles">
              {aldre.map((r) => (
                <li>
                  <h3>{r.home} {fmtScore(r)} {r.away}</h3>
                  <span class="meta">{fmtShortDay(r.date)}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )}

    <h2 class="section-gap" id="scheman">Klubbens spelschema</h2>
    <p class="prose">Det officiella och alltid aktuella spelschemat finns hos klubben. Tider kan ändras.</p>
    <ul class="list compact">
      <li><h3><a href={herr.schema} rel="noopener">Herrlaget</a></h3><span class="meta">almtuna.com</span></li>
    </ul>
    <h2 class="section-gap" id="infor-matchen">Inför matchen</h2>
    <ul class="list compact">
      <li><h3><a href="https://liveday.se/sv/stores/2bRJOsbrW5CNEjuZcGarec7mRcw" rel="noopener">Matchbiljetter</a></h3></li>
      <li><h3><a href="https://www.almtuna.com/sasongskort" rel="noopener">Säsongskort</a></h3></li>
      <li><h3><a href="https://www.almtuna.com/arenan" rel="noopener">Arenan</a></h3></li>
    </ul>
    {uppdaterad && <p class="meta">Senast uppdaterad {uppdaterad}.<br />Schema och resultat kommer från klubbens spelschema, kompletterat av en kalenderfil och <a href="https://www.thesportsdb.com/team/144401">TheSportsDB</a>. Tider kan ändras.</p>}
  </div>
</Base>
