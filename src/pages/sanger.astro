---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

// Texterna är ursprungligen hämtade från redlions.se (via archive.org).
const sanger: { title: string; melodi?: string; lank?: string; sok?: string[]; text: string[] }[] = [
  {
    title: 'Almtuna är laget som vi lever för',
    text: [
      'Almtuna är laget som vi lever för',
      'Vi är AIS och inget stoppar oss',
      'För vi är oslagbara!',
    ],
  },
  {
    title: 'Almtuna Å-Å',
    melodi: 'Volare',
    text: [
      'Almtuna Å-Å',
      'Almtuna Å-Å-Å-Å',
      'För er sjunger vi denna sång (klapp, klapp)',
      'Vi sjunger den gång efter gång.',
    ],
  },
  {
    title: 'Här kommer Almtunas gäng',
    melodi: 'Popeye the sailor man',
    text: [
      'Här kommer Almtunas gäng',
      'Nu ska ni få fett me däng (alt. Nu har ni fått fett me däng)',
      'Orken den tryter när lejonen ryter',
      'Här kommer Almtunas gäng',
    ],
  },
  {
    title: 'För vi är Tuna',
    melodi: 'Rule Britannia',
    text: [
      'För vi är Tuna och Gränby är vårt hem',
      'Och ingen jävel kommer hit och tar poäng.',
    ],
  },
  {
    title: 'Röda vita AIS',
    text: ['Röda vita AIS, AIS, AIS'],
  },
  {
    title: 'Vi älskar Tuna vit och röd',
    text: [
      'Vi älskar Tuna, vit och röd',
      'Vi älskar Tuna, vit och röd',
      'Vi älskar Tuna, vit och röd',
      'Almtuna till vår död',
    ],
  },
  {
    title: 'Forza Tuna',
    text: ['Forza Tuna in med pucken', 'Hej, hej'],
  },
  {
    title: 'Almtuna är dom bästa',
    text: ['Almtuna är dom bästa', 'Heja, heja, heja Tuna'],
  },
  {
    title: 'Vi följer vårt röda lag',
    melodi: 'Sloop John B / Jag hade en gång en båt',
    sok: ['Sloop John B'],
    text: [
      'Vi följer vårt röda lag, från Haparanda till Malmö stad',
      'När vägen kan kännas lång, så hör ni vår sång',
      'Vi följer vårt lag',
      'Vi följer vårt la-a-ag',
      'Tillsammans kämpar vi, för Uppsala stad',
      '(du du-du, du du-du, du du-du)',
    ],
  },
  {
    title: 'Nu är Red Lions här',
    text: [
      'Nu är Red Lions här',
      'Hela Sverige ska få se',
      'Red Lions på turné',
    ],
  },
  {
    title: 'Vi älskar vårat Tuna',
    melodi: 'Cielito Lindo',
    text: [
      'Åh AIS',
      'Vi älskar vårat Tuna',
      'Vi sjunger, vi krigar, Vi älskar vårt lag',
      'Ett skott, ett mål, för Tuna',
    ],
  },
  {
    title: 'Vi möter visst ett lag idag',
    melodi: 'The Silly Song / En tokig sång (Snövit och de sju dvärgarna)',
    text: [
      'Vi möter visst ett lag idag, som ska ned och kvala',
      'Men inte gör det oss någonting, för vi är från Uppsala',
    ],
  },
  {
    title: 'Kom igen Tuna',
    text: ['Kom igen Tuna (klapp klapp)', 'Kom igen Tuna (klapp klapp)', '...'],
  },
  {
    title: 'Kämpa AIS',
    text: ['Kämpa AIS', 'Kämpa AIS', '...'],
  },
];

// Lyssna: `lank` pekar på en exakt video (t.ex. YouTube/Spotify). Saknas den
// länkas en YouTube-sökning per sökfras i `sok`, annars på `melodi`.
// Inga ljudfiler lagras.
const ytSok = (q: string) =>
  `https://www.youtube.com/results?search_query=${encodeURIComponent(q)}`;
const lyssnaLankar = (s: { lank?: string; sok?: string[]; melodi?: string }) =>
  s.lank
    ? [{ text: 'Lyssna', url: s.lank }]
    : (s.sok ?? (s.melodi ? [s.melodi] : [])).map((q) => ({
        text: 'Lyssna på melodin (YouTube)',
        url: ytSok(q),
      }));
---
<Base title="Sånger">
  <PageHead title="Sånger">
    <p class="lead prose">Texterna till sångerna vi sjunger på läktaren.</p>
  </PageHead>
  <div class="wrap page">
    <div class="songs">
      {sanger.map((s) => (
        <section class="song prose">
          <h2>{s.title}</h2>
          {s.melodi && <p class="meta">Melodi: {s.melodi}</p>}
          {lyssnaLankar(s).map((l) => (
            <p class="meta">
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.text}</a>
            </p>
          ))}
          <p class="lyrics">{s.text.join('\n')}</p>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .songs {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  .song h2 {
    margin-bottom: 0.25rem;
  }
  .lyrics {
    white-space: pre-line;
  }
</style>
