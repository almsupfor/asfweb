---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { media } from '../data/media';
import { nextMatch as getNext, lastResult as getLast, fmtDay, fmtShortDay, fmtTime, fmtScore } from '../data/matches';

const senaste = media.filter((m) => m.type !== 'podd').slice(0, 3);
const avsnitt = media.filter((m) => m.type === 'podd').slice(0, 2);
const kommande = getNext();
const senastRes = getLast();
const fmt = (d: string) => new Date(d).toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base>
  <section class="hero">
    <div class="wrap">
      <h1>Vi står upp för Almtuna.</h1>
      <p class="lead">{site.name} är fristående från Almtuna IS.</p>
      <div class="hero-actions">
        <a class="button" href="/bli-medlem">Bli medlem</a>
        <a class="hero-link" href="/matcher#bortaresor">Se bortaresor</a>
      </div>
    </div>
  </section>

  <div class="wrap page">
    {(kommande || senastRes) && (
      <>
        <h2>Matcher</h2>
        <div class="cards">
          {kommande && (
            <div class="card">
              <h3>Nästa match</h3>
              <p class="match">{kommande.home} – {kommande.away}</p>
              <p class="meta">{fmtDay(kommande.date)} · {fmtTime(kommande)}</p>
              <p class="meta">{kommande.isHome ? 'Hemma' : 'Borta'}{kommande.venue ? ` · ${kommande.venue}` : ''}{kommande.kind === 'training' ? ' · Träningsmatch' : ''}</p>
            </div>
          )}
          {senastRes && (
            <div class="card">
              <h3>Senaste resultat</h3>
              <p class="match">{senastRes.home} {fmtScore(senastRes)} {senastRes.away}</p>
              <p class="meta">{fmtShortDay(senastRes.date)}</p>
            </div>
          )}
        </div>
        <p><a href="/matcher">Hela spelschemat</a></p>
      </>
    )}
    {senaste.length > 0 && (
      <>
        <h2 class="section-gap">Senast i media</h2>
        <ul class="list prose">
          {senaste.map((m) => (
            <li>
              <h3><a href={m.url} rel="noopener">{m.title}</a></h3>
              <span class="meta">{m.source} · {fmt(m.date)}</span>
            </li>
          ))}
        </ul>
        <p><a href="/i-media">Alla artiklar om Almtuna</a></p>
      </>
    )}
    {avsnitt.length > 0 && (
      <>
        <h2 class="section-gap">Podd</h2>
        <ul class="list prose">
          {avsnitt.map((m) => (
            <li>
              <h3><a href={m.url} rel="noopener">{m.title}</a></h3>
              <span class="meta">Inside Almtuna · {fmt(m.date)}</span>
            </li>
          ))}
        </ul>
        <p><a href="/i-media#podd">Alla avsnitt</a></p>
      </>
    )}
    <h2 class="section-gap">Utforska</h2>
    <div class="cards">
      <a class="card" href="/matcher#bortaresor"><h3>Bortaresor</h3><p>Följ med laget på resan.</p></a>
      <a class="card" href="/sanger"><h3>Sånger</h3><p>Texterna till läktarens sånger.</p></a>
      <a class="card" href="/i-media"><h3>I media</h3><p>Artiklar om Almtuna från andra tidningar.</p></a>
    </div>
  </div>
</Base>
