---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { media, lagFor, lagNamn } from '../data/media';
import MediaItem from '../components/MediaItem.astro';
import { nextMatch as getNext, lastResult as getLast, upcoming, fmtDay, fmtShortDay, fmtTime, fmtScore } from '../data/matches';

const senaste = media.filter((m) => m.type !== 'podd').slice(0, 3);
const kommande = getNext();
const nastaBorta = upcoming().find((m) => !m.isHome) ?? null;
const senastRes = getLast();
const fmt = (d: string) => new Date(d).toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base>
  <section class="hero">
    <div class="wrap">
      <h1>Vi står upp för Almtuna.</h1>
      <p class="lead">Stämning, bortaresor och gemenskap för alla som håller på Almtuna IS.</p>
      <div class="hero-actions">
        <a class="button" href="/bli-medlem">Bli medlem</a>
        <a class="hero-link" href="/bortaresor">Se bortaresor</a>
      </div>
    </div>
  </section>

  <div class="wrap page">
    <section class="feature" aria-labelledby="bortaresor-rubrik">
      <div>
        <h2 id="bortaresor-rubrik">Bortaresor</h2>
        <p>Följ med på bortamatcherna och heja fram Almtuna IS.</p>
        <p><a class="button" href="/bortaresor">Om bortaresor</a></p>
      </div>
      {/* Visar nästa bortamatch. Finns en publicerad bortaresa ersätter skriptet nedan kortet med den. */}
      <div class="match-card" id="next-away" hidden={!nastaBorta}>
        {nastaBorta && (
          <>
            <h3>Nästa bortamatch</h3>
            <p class="match">{nastaBorta.home} – {nastaBorta.away}</p>
            <p class="meta">{fmtDay(nastaBorta.date)} · {fmtTime(nastaBorta)}{nastaBorta.venue ? ` · ${nastaBorta.venue}` : ''}</p>
          </>
        )}
      </div>
    </section>
    <h2 class="section-gap">Utforska</h2>
    <div class="cards">
      <a class="card" href="/laget"><h3>Laget</h3><p>Tabeller och länkar till trupp och schema.</p></a>
      <a class="card" href="/sanger"><h3>Sånger</h3><p>Texterna till läktarens sånger.</p></a>
      <a class="card" href="/i-media"><h3>I media</h3><p>Artiklar om Almtuna från andra tidningar.</p></a>
    </div>
    {(kommande || senastRes) && (
      <>
        <h2 class="section-gap">Matcher</h2>
        <div class="cards">
          {kommande && (
            <div class="card match-card">
              <h3>Nästa match</h3>
              <p class="match">{kommande.home} – {kommande.away}</p>
              <p class="meta">{fmtDay(kommande.date)} · {fmtTime(kommande)}</p>
              <p class="meta">{kommande.isHome ? 'Hemma' : 'Borta'}{kommande.venue ? ` · ${kommande.venue}` : ''}{kommande.kind === 'training' ? ' · Träningsmatch' : ''}</p>
            </div>
          )}
          {senastRes && (
            <div class="card match-card">
              <h3>Senaste resultat</h3>
              <p class="match">{senastRes.home} {fmtScore(senastRes)} {senastRes.away}</p>
              <p class="meta">{fmtShortDay(senastRes.date)}</p>
            </div>
          )}
        </div>
        <p><a href="/matcher">Hela spelschemat</a></p>
      </>
    )}
    {senaste.length > 0 && (
      <>
        <h2 class="section-gap">Senast i media</h2>
        <ul class="list prose">
          {senaste.map((m) => <MediaItem item={m} lagLabel={lagNamn[lagFor(m)]} />)}
        </ul>
        <p><a href="/i-media">Alla artiklar om Almtuna</a></p>
      </>
    )}
  </div>
</Base>

<script>
  // The next published trip replaces "Nästa bortamatch". Without one, or if the request fails, the card stays as built.
  // Plain fetch (not supabase-js) keeps the front page light.
  import { SUPABASE_URL, SUPABASE_KEY } from '../data/supabase';
  import { el, tripAction, tripWhen, kr, type Trip, type Spots } from '../lib/trips';

  const card = document.getElementById('next-away');
  if (card) load(card);

  async function load(card: HTMLElement) {
    try {
      const today = new Date().toLocaleDateString('sv-SE');
      const headers = { apikey: SUPABASE_KEY };
      const [tripRes, spotsRes] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/trips?select=*&published=eq.true&trip_date=gte.${today}&order=trip_date.asc&limit=1`, { headers }),
        fetch(`${SUPABASE_URL}/rest/v1/rpc/trip_spots`, { method: 'POST', headers: { ...headers, 'Content-Type': 'application/json' }, body: '{}' }),
      ]);
      if (!tripRes.ok) return;
      const [trip] = (await tripRes.json()) as Trip[];
      if (!trip) return;
      const spots = spotsRes.ok ? ((await spotsRes.json()) as Spots[]).find((s) => s.trip_id === trip.id) : undefined;
      card.replaceChildren(
        el('h3', {}, 'Nästa bortaresa'),
        el('p', { class: 'match' }, trip.title),
        el('p', { class: 'meta' }, tripWhen(trip)),
        el('p', { class: 'meta' }, `Medlem ${kr(trip.price_member)}, övriga ${kr(trip.price_other)}`),
        el('p', {}, tripAction(trip, (spots?.taken ?? 0) >= trip.capacity)),
      );
      card.hidden = false;
    } catch {
      // Keep the match card.
    }
  }
</script>
