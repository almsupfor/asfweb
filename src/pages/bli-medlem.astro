---
import Base from '../layouts/Base.astro';
import Mail from '../components/Mail.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Bli medlem">
  <PageHead title="Bli medlem">
    <p class="lead">Som medlem stöttar du föreningen och får vara med och påverka.</p>
  </PageHead>
  <div class="wrap page">
    <div class="prose">
      <p>Medlemsavgiften är 100 kr och gäller en säsong, från 1 juli till 30 juni.</p>
      <p class="notice">Medlemsanmälan online öppnar snart. Det går redan nu att bli medlem i samband med våra bortaresor eller möten.<br /><br />Om du har frågor kring medlemskapet kan du mejla oss på <Mail subject="Medlemskap" />.</p>
      <!-- TODO (senare): medlemsanmälan online med Swish när det går att ta emot betalning på sajten. -->
    </div>
  </div>
</Base>
