---
import Base from '../layouts/Base.astro';
import Mail from '../components/Mail.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Bli medlem">
  <PageHead title="Bli medlem">
    <p class="lead">Som medlem stöttar du föreningen och får vara med och påverka.</p>
  </PageHead>
  <div class="wrap page">
    <div class="prose">
      <p>Medlemsavgiften är 100 kr.</p>
      <p class="notice">Medlemsanmälan online öppnar snart. Det går även att bli medlem i samband med våra bussresor.<br /><br />Om du har frågor kring medlemskapet kan du mejla oss på <Mail subject="Medlemskap" />.</p>
      <!-- TODO: avgift, Swish-nummer och anmälningsformulär när det är beslutat. -->
    </div>
  </div>
</Base>
