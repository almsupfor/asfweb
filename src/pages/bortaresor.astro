---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Mail from '../components/Mail.astro';
import { upcoming, fmtDay, fmtTime } from '../data/matches';
import { DIREKT } from '../data/visning';

const bortamatcher = upcoming().filter((m) => !m.isHome);
// De närmaste bortamatcherna visas direkt, resten ligger bakom "Visa fler".
const narmast = bortamatcher.slice(0, DIREKT);
const fler = bortamatcher.slice(DIREKT);
---
<Base title="Bortaresor" description="Följ med Almtuna IS på bortamatcherna: föreningens resor och kommande bortamatcher.">
  <PageHead title="Bortaresor">
    <p class="lead prose">Följ med på bortamatcherna och heja fram Almtuna IS.</p>
  </PageHead>
  <div class="wrap page">
    <h2>Föreningens resor</h2>
    <div id="trips" aria-live="polite">
      <p class="notice prose">Mer information om nästa bortaresa kommer.<br /><br />Håll utkik här eller mejla <Mail /> om du har frågor eller funderingar.</p>
    </div>

    <h2 class="section-gap" id="bortamatcher">Kommande bortamatcher</h2>
    {bortamatcher.length === 0 ? (
      <p class="notice prose">Inga bortamatcher är inlagda just nu.</p>
    ) : (
      <>
        <ul class="tiles">
          {narmast.map((m) => (
            <li>
              <h3>{m.home} – {m.away}</h3>
              <span class="meta">{fmtDay(m.date)} · {fmtTime(m)}{m.venue ? ` · ${m.venue}` : ''}{m.kind === 'training' ? ' · Träningsmatch' : ''}</span>
            </li>
          ))}
        </ul>
        {fler.length > 0 && (
          <details class="more">
            <summary><span class="s-closed">Visa fler ({fler.length})</span><span class="s-open">Visa färre</span></summary>
            <ul class="tiles">
              {fler.map((m) => (
                <li>
                  <h3>{m.home} – {m.away}</h3>
                  <span class="meta">{fmtDay(m.date)} · {fmtTime(m)}{m.venue ? ` · ${m.venue}` : ''}{m.kind === 'training' ? ' · Träningsmatch' : ''}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </>
    )}
    <p class="meta prose"><a href="/matcher">Hela spelschemat</a></p>
  </div>
</Base>

<script>
  // Trips come from the database. The notice above stays if there are none, or if the request fails.
  // Plain fetch with the anon key (as on the front page): supabase-js waits for a stored login session
  // first, which can stall this public list for visitors who have used /admin.
  import { SUPABASE_URL, SUPABASE_KEY } from '../data/supabase';
  import { el, externalLink, kr, tripAction, tripWhen, type Trip, type Spots } from '../lib/trips';

  const root = document.getElementById('trips');
  if (root) load(root);

  async function load(root: HTMLElement) {
    const today = new Date().toLocaleDateString('sv-SE');
    const headers = { apikey: SUPABASE_KEY };
    let trips: Trip[];
    let spotList: Spots[] = [];
    try {
      const [tripsRes, spotsRes] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/trips?select=*&published=eq.true&trip_date=gte.${today}&order=trip_date.asc`, { headers }),
        fetch(`${SUPABASE_URL}/rest/v1/rpc/trip_spots`, { method: 'POST', headers: { ...headers, 'Content-Type': 'application/json' }, body: '{}' }),
      ]);
      if (!tripsRes.ok) return;
      trips = (await tripsRes.json()) as Trip[];
      if (spotsRes.ok) spotList = (await spotsRes.json()) as Spots[];
    } catch {
      return;
    }
    if (trips.length === 0) return;
    const spots = new Map(spotList.map((s) => [s.trip_id, s]));

    const list = el('ul', { class: 'tiles trip-cards' });
    for (const t of trips) {
      const taken = spots.get(t.id)?.taken ?? 0;
      const full = taken >= t.capacity;
      const ext = externalLink(t.external_url);
      list.append(
        el('li', {},
          el('h3', {}, t.title),
          el('p', { class: 'meta' }, tripWhen(t)),
          el('p', { class: 'trip-prices' }, el('span', {}, `Medlem ${kr(t.price_member)}`), el('span', {}, `Övriga ${kr(t.price_other)}`)),
          ext ? el('p', { class: 'trip-spots' }, 'Anmälan sker via extern länk') : el('p', { class: 'trip-spots' }, `Anmälda ${taken} / ${t.capacity}`),
          tripAction(t, full),
        ),
      );
    }
    root.replaceChildren(list);
  }
</script>
