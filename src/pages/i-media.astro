---
import Base from '../layouts/Base.astro';
import { media, mediaUpdated, lagFor } from '../data/media';
import Mail from '../components/Mail.astro';
import MediaItem from '../components/MediaItem.astro';
import PageHead from '../components/PageHead.astro';
import { DIREKT } from '../data/visning';

const artiklar = media.filter((m) => m.type !== 'podd');
// De senaste visas direkt, resten ligger bakom "Äldre". Taket är hur många rader en sektion får ha.
const bygg = (id: string, namn: string, alla: typeof media, tak: number, enhet: 'artiklar' | 'avsnitt', knapp = namn) => {
  const visa = alla.slice(0, tak);
  const oppna = Math.min(DIREKT, visa.length);
  return { id, namn, knapp, enhet, visa, total: alla.length, kapad: alla.length > visa.length, nu: visa.slice(0, oppna), aldre: visa.slice(oppna) };
};
const aLaget = bygg('herrlaget', 'Herrlaget',artiklar.filter((m) => lagFor(m) === 'a-lag'), 60, 'artiklar');
// Herrlaget står först. De andra ordnas efter hur mycket de innehåller.
const ovriga = [
  bygg('damlaget', 'Damlaget', artiklar.filter((m) => lagFor(m) === 'dam'), 20, 'artiklar'),
  bygg('u20', 'U20', artiklar.filter((m) => lagFor(m) === 'j20'), 20, 'artiklar'),
  bygg('u18', 'U18', artiklar.filter((m) => lagFor(m) === 'j18'), 20, 'artiklar'),
  bygg('podd', 'Podd', media.filter((m) => m.type === 'podd'), 20, 'avsnitt'),
].filter((s) => s.visa.length > 0).sort((a, b) => b.visa.length - a.visa.length);
const sektioner = [aLaget, ...ovriga];
const hopp = sektioner.filter((s) => s.visa.length > 0);
const enhetFor = (s: (typeof sektioner)[number], n: number) => (s.enhet === 'artiklar' && n === 1 ? 'artikel' : s.enhet);
const antalText = (s: (typeof sektioner)[number]) => (s.kapad ? `${s.visa.length} av ${s.total}` : `${s.visa.length}`);
const uppdaterad = mediaUpdated ? new Date(mediaUpdated).toLocaleString('sv-SE', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Stockholm' }) : null;
---
<Base title="I media" description="Artiklar och poddavsnitt om Almtuna IS från tidningar och andra medier.">
  <PageHead title="I media">
      <p class="lead prose">Artiklar och poddavsnitt om Almtuna IS.<br />Listan uppdateras automatiskt och vi länkar till originalet.</p>
      {hopp.length > 1 && (
        <nav class="jump" aria-label="Hoppa till">
          {hopp.map((s) => <a href={`#${s.id}`} aria-label={`${s.knapp}, ${antalText(s)} ${enhetFor(s, s.total)}`}>{s.knapp} <span class="meta" aria-hidden="true">{antalText(s)}</span></a>)}
        </nav>
      )}
  </PageHead>
  <div class="wrap page">
    {sektioner.map((s, i) => (
      s.visa.length === 0 ? (
        <>
          <h2 class="sektion" id={s.id}>{s.namn}</h2>
          <p class="notice prose">Inga artiklar är inlagda ännu. Har du hittat något som borde vara med? Mejla länken till <Mail subject="Artikeltips" />.</p>
        </>
      ) : (
        <>
          <h2 class:list={['sektion', i > 0 && 'section-gap']} id={s.id}>{s.namn}</h2>
          {s.id === 'podd' && <p class="prose">Inside Almtuna. Avsnitten spelas på poddens egen sida.</p>}
          <ul class="tiles">
            {s.nu.map((m) => <MediaItem item={m} showSource={s.id !== 'podd'} />)}
          </ul>
          {s.aldre.length > 0 && (
            <details class="more">
              <summary><span class="s-closed">Äldre {s.enhet} ({s.aldre.length})</span><span class="s-open">Visa färre</span></summary>
              <ul class="tiles">
                {s.aldre.map((m) => <MediaItem item={m} showSource={s.id !== 'podd'} />)}
              </ul>
            </details>
          )}
          {s.kapad && <p class="meta">Visar de {s.visa.length} senaste av {s.total} {s.enhet}. Äldre finns hos {s.id === 'podd' ? 'poddens egen sida' : 'respektive tidning'}.</p>}
        </>
      )
    ))}

    <p class="meta section-gap">Rubrikerna hämtas från mediernas egna flöden.{uppdaterad && mediaUpdated && <><br />Listan hämtades senast <time datetime={mediaUpdated}>{uppdaterad}</time>.</>}</p>
  </div>
</Base>
