---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Kontakt">
  <div class="wrap page">
    <h1>Kontakt</h1>
    <div class="prose">
      <p>Frågor, idéer eller vill du hjälpa till? Mejla oss på <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </div>
</Base>
