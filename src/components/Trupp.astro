---
// Spelarstatistik för ett lag. Visas bara om det finns spelare att visa.
import { squad, goalkeepers, squadUpdated, hasPlayed } from '../data/squads';
import type { LagKey } from '../data/lagen';
interface Props { lag: LagKey; }
const { lag } = Astro.props;
const alla = squad(lag);
const malvakter = goalkeepers(lag);
const keeperNames = new Set(malvakter.map((k) => k.name));
const spelat = alla.filter(hasPlayed);
const utan = alla.filter((p) => !hasPlayed(p) && !keeperNames.has(p.name));
const diff = (n: number) => (n > 0 ? `+${n}` : String(n));
// Tidsstämpeln ändras bara när något ändrats, så den visar senaste ändring och inte senaste försök.
const uppdaterad = squadUpdated ? new Date(squadUpdated).toLocaleString('sv-SE', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Stockholm' }) : null;
---
{alla.length > 0 && (
  <>
    <h3 class="section-gap">Spelare denna säsong</h3>
    <p class="meta">Statistik för utespelare, med flest poäng överst</p>
    {spelat.length > 0 && (
      <div class="table-scroll" tabindex="0" role="region" aria-label="Spelarstatistik">
        <table class="standings players-table">
          <caption class="sr-only">Spelarstatistik denna säsong</caption>
          <thead>
            <tr>
              <th scope="col"><button type="button" class="sort-btn">Spelare</button></th>
              <th scope="col"><button type="button" class="sort-btn"><abbr title="Spelade matcher">S</abbr></button></th>
              <th scope="col"><button type="button" class="sort-btn"><abbr title="Mål">M</abbr></button></th>
              <th scope="col"><button type="button" class="sort-btn"><abbr title="Assist">A</abbr></button></th>
              <th scope="col"><button type="button" class="sort-btn"><abbr title="Poäng">P</abbr></button></th>
              <th scope="col"><button type="button" class="sort-btn"><abbr title="Plus/minus">+/-</abbr></button></th>
              <th scope="col"><button type="button" class="sort-btn"><abbr title="Utvisningsminuter">UTV</abbr></button></th>
            </tr>
          </thead>
          <tbody>
            {spelat.map((p) => (
              <tr>
                {/* Tröjnummer är dolda tills klubben har lagt in dem för hela laget: <th>{p.number != null ? `#${p.number} ` : ''}{p.name}</th> */}
                <th scope="row">{p.name}</th>
                <td data-v={p.gp}>{p.gp}</td><td data-v={p.g}>{p.g}</td><td data-v={p.a}>{p.a}</td><td class="pts" data-v={p.tp}>{p.tp}</td><td data-v={p.pm}>{diff(p.pm)}</td><td data-v={p.pim}>{p.pim}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {malvakter.length > 0 && (
      <>
        <h3 class="section-gap">Målvakter denna säsong</h3>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Målvaktsstatistik">
          <table class="standings players-table">
            <caption class="sr-only">Målvaktsstatistik denna säsong</caption>
            <thead>
              <tr>
                <th scope="col"><button type="button" class="sort-btn">Målvakt</button></th>
                <th scope="col"><button type="button" class="sort-btn"><abbr title="Spelade matcher">S</abbr></button></th>
                <th scope="col"><button type="button" class="sort-btn"><abbr title="Räddningsprocent">RÄDD%</abbr></button></th>
                <th scope="col"><button type="button" class="sort-btn"><abbr title="Insläppta mål per match">SNITT</abbr></button></th>
                <th scope="col"><button type="button" class="sort-btn"><abbr title="Insläppta mål">IM</abbr></button></th>
                <th scope="col"><button type="button" class="sort-btn"><abbr title="Hållna nollor">NOLL</abbr></button></th>
                <th scope="col"><button type="button" class="sort-btn"><abbr title="Speltid i minuter">MIN</abbr></button></th>
              </tr>
            </thead>
            <tbody>
              {malvakter.map((k) => (
                <tr>
                  <th scope="row">{k.name}</th>
                  <td data-v={k.gp}>{k.gp}</td><td class="pts" data-v={k.svsPerc}>{k.svsPerc ?? '–'}</td><td data-v={k.gaa}>{k.gaa ?? '–'}</td><td data-v={k.ga}>{k.ga}</td><td data-v={k.so}>{k.so}</td><td data-v={k.mip}>{k.mip ?? '–'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {uppdaterad && squadUpdated && <p class="meta">(uppdaterad <time datetime={squadUpdated}>{uppdaterad}</time>)</p>}
    {utan.length > 0 && (
      <p class="meta">Spelare utan speltid, utan statistik här: {utan.map((p) => p.name).join(', ')}.</p>
    )}
  </>
)}
<script>
  // Klick på en kolumnrubrik sorterar tabellen. Namn stigande först, siffror fallande först. Nytt klick vänder.
  document.querySelectorAll<HTMLTableElement>('.players-table').forEach((table) => {
    const body = table.tBodies[0];
    const heads = [...table.tHead!.rows[0].cells];
    heads.forEach((th, col) => {
      th.querySelector('button')?.addEventListener('click', () => {
        const text = col === 0;
        const dir = th.getAttribute('aria-sort') === (text ? 'ascending' : 'descending') ? (text ? 1 : -1) * -1 : text ? 1 : -1;
        const val = (tr: HTMLTableRowElement) => {
          const c = tr.cells[col];
          if (text) return c.textContent!.trim();
          const v = c.dataset.v;
          return v === undefined || v === '' ? null : Number(v);
        };
        const rows = [...body.rows];
        rows.sort((a, b) => {
          const x = val(a), y = val(b);
          if (x === null || y === null) return x === y ? 0 : x === null ? 1 : -1; // saknade värden sist
          return (typeof x === 'string' ? x.localeCompare(y as string, 'sv') : x - (y as number)) * dir;
        });
        body.append(...rows);
        heads.forEach((h) => h.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
      });
    });
  });
</script>
