---
// En rad i listan "I media": rubriken länkar till originalet i en ny flik.
// Det syns som en pil och sägs till skärmläsare, eftersom webbläsaren annars byter flik utan förvarning.
import type { MediaItem } from '../data/media';

interface Props { item: MediaItem; showSource?: boolean; }
const { item, showSource = true } = Astro.props;
const date = new Date(item.date);
const label = date.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' });
---
<li>
  <h3>
    <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}<svg class="ext" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M4.5 2H10v5.5M10 2 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg><span class="sr-only"> (öppnas i ny flik)</span></a>
  </h3>
  <span class="meta">{showSource && `${item.source} · `}<time datetime={item.date}>{label}</time></span>
</li>
