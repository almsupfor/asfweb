---
// E-postlänk som inte ligger i klartext i HTML:en: adressen delas upp och sätts ihop i webbläsaren.
// Utan JavaScript visas adressen som "namn (snabel-a) domän". Ger du innehåll (slot) blir det länktexten.
import { site } from '../data/site';

interface Props { subject?: string; class?: string; }
const { subject = '', class: cls } = Astro.props;
const [user, domain] = site.email.split('@');
const custom = Astro.slots.has('default');
---
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-mail-u]').forEach((a) => {
    const address = `${a.dataset.mailU}@${a.dataset.mailD}`;
    const subject = a.dataset.mailS;
    a.href = `mailto:${address}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
    if (a.dataset.mailText !== undefined) a.textContent = address;
  });
</script>
<a class={cls} data-mail-u={user} data-mail-d={domain} data-mail-s={subject} data-mail-text={custom ? undefined : ''}>{custom ? <slot /> : `${user} (snabel-a) ${domain}`}</a>