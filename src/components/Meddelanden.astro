---
import { aktuellaMeddelanden } from '../data/meddelanden';
import { infoBarQueries, infoRows } from '../lib/meetings';
import { SUPABASE_URL, SUPABASE_KEY } from '../data/supabase';

const items = aktuellaMeddelanden();

// Meetings and the next away trip, entered on /admin, are put in the bar when the site is built, so the bar is there from the
// first paint and does not push the page down. The script below checks again in the browser and corrects the bar if
// something changed since the build. If the request fails here the bar is built without them.
const get = async (path: string) => {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, { headers: { apikey: SUPABASE_KEY } });
    return res.ok ? await res.json() : [];
  } catch {
    return [];
  }
};
const q = infoBarQueries();
const auto = infoRows(await get(q.meetings), await get(q.trips));
---
<section class="info-bar" aria-label="Viktigt just nu" hidden={items.length + auto.length === 0}>
  <ul class="wrap">
    {items.map((m) => (
      <li>
        <span class="info-text">{m.text}</span>{m.länk && m.länk.href && <>{' '}<a class="info-link" href={m.länk.href}>{m.länk.etikett}</a></>}
      </li>
    ))}
    {auto.map((r) => (
      <li data-auto>
        <span class="info-text">{r.text}</span>{' ('}<a class="info-link" href={r.href}>mer info</a>)
      </li>
    ))}
  </ul>
</section>

<script>
  // Check the automatic rows again when the page opens. They were built into the page, so this only changes the bar
  // if a meeting or trip was added, changed or has passed since the last build.
  // Plain fetch (not supabase-js) keeps every page light. If a request fails the bar is left as built.
  import { SUPABASE_URL, SUPABASE_KEY } from '../data/supabase';
  import { el } from '../lib/trips';
  import { infoBarQueries, infoRows, type Meeting } from '../lib/meetings';
  import type { Trip } from '../lib/trips';

  const get = async <T,>(path: string): Promise<T[]> => {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, { headers: { apikey: SUPABASE_KEY } });
    if (!res.ok) throw new Error(res.statusText);
    return (await res.json()) as T[];
  };

  async function refresh(bar: HTMLElement, list: Element) {
    const q = infoBarQueries();
    const [meetings, trips] = await Promise.all([get<Meeting>(q.meetings), get<Trip>(q.trips)]);
    const rows = infoRows(meetings, trips).map((r) =>
      el('li', { 'data-auto': '' }, el('span', { class: 'info-text' }, r.text), ' (', el('a', { class: 'info-link', href: r.href }, 'mer info'), ')'),
    );
    const current = [...list.querySelectorAll('li[data-auto]')];
    const same = current.length === rows.length && current.every((li, i) => li.textContent === rows[i].textContent);
    if (same) return;
    current.forEach((li) => li.remove());
    list.append(...rows);
    bar.hidden = list.children.length === 0;
  }

  const bar = document.querySelector<HTMLElement>('.info-bar');
  const list = bar?.querySelector('ul');
  if (bar && list) refresh(bar, list).catch(() => {});
</script>
